{
  "name": "macro-task-inbox-artifact",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild:sdk": "bun run --cwd ../../../packages/sdk build",
    "dev": "bun run prebuild:sdk && vite build --watch",
    "build": "bun run prebuild:sdk && vite build && bun run validate:dist",
    "deploy": "bun run build && bun src/deploy.ts",
    "worker": "bun src/worker.ts",
    "test": "bun run test:unit && bun run test:ui",
    "test:unit": "bun test src",
    "test:ui": "vitest run --config vitest.config.ts",
    "validate:dist": "bun scripts/validate-browser-output.ts"
  },
  "dependencies": {
    "@macro/sdk": "file:../../../packages/sdk",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-plugin-solid": "^2.11.11",
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
