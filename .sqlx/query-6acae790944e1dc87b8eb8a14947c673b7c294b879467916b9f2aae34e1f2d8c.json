{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT major, minor, changelog, forced_major, review_state, created_at\n            FROM marketplace_listing_version\n            WHERE listing_id = $1\n              AND (\n                  review_state = 'approved'\n                  OR ($2::bool AND review_state = 'pending')\n              )\n            ORDER BY major DESC, minor DESC\n            ",
