{
	"name": "@macro/plugin-ui",
	"version": "0.0.1",
	"description": "Standalone SolidJS 2 UI kit for Macro client plugins (iframe-safe, no host or app runtime imports)",
	"type": "module",
	"sideEffects": [
		"./dist/styles.css"
	],
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest run",
		"build": "rm -rf dist && node scripts/build.mjs && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
		"build:catalog": "rm -rf dist-catalog && vite build --config vitest.catalog.config.ts"
	},
	"peerDependencies": {
		"solid-js": "2.0.0-rc.1",
		"@solidjs/web": "2.0.0-rc.1"
	},
	"devDependencies": {
		"@dom-expressions/compiler": "0.50.0-next.43",
		"@solidjs/web": "2.0.0-rc.1",
		"@testing-library/dom": "^10.4.0",
		"jsdom": "^26.1.0",
		"solid-js": "2.0.0-rc.1",
		"typescript": "^5.9.2",
		"vite": "^7.3.1",
		"vitest": "^3.2.4"
	}
}
